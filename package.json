{
  "name": "khoa-luan",
  "version": "1.0.0",
  "description": "Adaptive Learning Platform - Thesis Project",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
